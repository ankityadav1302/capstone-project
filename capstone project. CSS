/* Basic Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Body Styling */
body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    color: #333;
}

/* Header Styling */
header {
    text-align: center;
    background-color: #004aad;
    color: white;
    padding: 30px 0;
}

header h1 {
    font-size: 36px;
    margin-bottom: 10px;
}

/* Listings Section */
.listings {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 40px;
    flex-wrap: wrap;
}

/* Property Card */
.property-card {
    background-color: white;
    width: 300px;
    border-radius: 10px;
    padding-bottom: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    text-align: center;
}

.property-card img {
    width: 100%;
    border-radius: 10px 10px 0 0;
}

.property-card h2 {
    padding: 10px 0;
}

.price {
    font-size: 20px;
    font-weight: bold;
    color: #0077cc;
}

.description {
    padding: 0 15px;
    margin-bottom: 15px;
}

/* Button */
.btn {
    background-color: #0077cc;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.btn:hover {
    background-color: #005fa3;
}

/* Footer */
footer {
    text-align: center;
    padding: 15px 0;
    background-color: #004aad;
    color: white;
    margin-top: 20px;
}
